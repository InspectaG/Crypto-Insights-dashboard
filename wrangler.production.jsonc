{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gatchek-crypto-signals",
  "account_id": "99a83b9776d1f74da2f5116555cfc0a2",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "crypto.gatchek.com/*",
      "zone_name": "gatchek.com"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gatchek-crypto-signals-prod",
      "database_id": "13cf8909-e2cb-4e9b-a23f-ac7eae9f7739",
      "migrations_dir": "drizzle"
    }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ]
}
